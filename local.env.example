# Local development settings for the Looki backend. Copy this file OUTSIDE
# the repository and fill it in (never commit the real file):
#   Windows: %LOCALAPPDATA%\Looki\postgres.env
#   macOS/Linux: ~/.looki/local.env
# run-local.sh / run-local.ps1 read it, create the PostgreSQL container on
# first run, and start the backend on http://localhost:8081.

# Local PostgreSQL in Docker. Pick any strong password; it is only used locally.
POSTGRES_DB=loomea
POSTGRES_USER=loomea
POSTGRES_PASSWORD=change-me-to-a-random-password

# JWT signing key: any random string of at least 64 characters, e.g.
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# AI features (Modal). Leave empty to run without AI: search falls back to
# keyword search, insights show numbers only, and the support chat says
# "unavailable". Get the token and URLs from the person who deployed
# ai/looki_ai_modal.py, or deploy it to your own Modal account (see README).
MODAL_AI_TOKEN=
MODAL_SEARCH_URL=
MODAL_INSIGHTS_URL=
MODAL_SUPPORT_URL=

# Password for the demo accounts created by ai/demo_owner.sql
# (owner@looki.demo and client1@looki.demo). Choose any password.
DEMO_OWNER_PASSWORD=

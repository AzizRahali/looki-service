# ─── Spring Boot ───────────────────────────────────────────
SERVER_PORT=8080

# ─── PostgreSQL ────────────────────────────────────────────
POSTGRES_PORT=5432
POSTGRES_DB=loomea
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/loomea
SPRING_DATASOURCE_USERNAME=loomea
SPRING_DATASOURCE_PASSWORD=loomea123

# ─── JWT ───────────────────────────────────────────────────
APP_JWT_SECRET=loomea-docker-secret-key-change-in-production-min-256-bits-long
JWT_SECRET=loomea-docker-secret-key-change-in-production-min-256-bits-long

# ─── Twilio ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── pgAdmin ───────────────────────────────────────────────
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@loomea.com
PGADMIN_DEFAULT_PASSWORD=admin123
